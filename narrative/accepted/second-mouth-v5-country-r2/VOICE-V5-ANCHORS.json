{
  "status": "Exact compiled v5 anchors selected by lead for development. Not a blind voice attribution test or owner approval.",
  "contentSha256": "d4b4cea49996aaa28d2e40a2a56577c833d2235b7c2fa9d0aa59ee27339c24e8",
